{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./server",
    "outDir": "./dist/server"
  },
  "include": ["server/**/*"],
  "exclude": ["server/test_*.ts", "server/live_qa_test.ts", "node_modules", "client"]
}
